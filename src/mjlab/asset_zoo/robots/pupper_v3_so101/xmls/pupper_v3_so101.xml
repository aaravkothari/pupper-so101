<!--
  Pupper v3 with an SO-101 arm on its back (Hiwonder kit = stock SO-101 geometry).

  - Pupper: identical to ../../pupper_v3/xmls/pupper_v3.xml (meshes shared).
  - Printed mounts (pupper_so101_mount_v3): Part A "saddle" (v4) on the rear
    deck, Part B "arm base" (replaces the stock SO-101 table base). Their meshes are
    already in the base_link frame; see build_assets.py.
  - SO-101: TheRobotStudio/SO-ARM100 Simulation/SO101/so101_new_calib.xml
    (Apache-2.0), names prefixed so101_, visual-only, stock base mesh removed.
    Wrist camera: SO-ARM100's one-piece wrist cam mount for a 32 x 32 mm UVC
    module replaces the fixed-jaw (wrist roll follower) part; the module is a
    board + lens holder mesh with a MuJoCo camera "so101_wrist_cam".
    The arm keeps its 6 joints here; pupper_so101_constants.get_spec() locks
    them into the stowed pose for walking.
  - Arm power under the front belly: a printed sled push-pinned into 4 of the
    belly's vent holes (placed from its pin holes, see build_assets.py), open
    side down, holding a UGREEN 145 W 25000 mAh power bank (a box) on a
    slide-in floor. Pupper's DeWalt stays.
-->
<mujoco model="pupper_v3_so101">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <!-- Visual geoms live in group 1 and never collide. -->
    <geom condim="3" contype="0" conaffinity="0" group="1"/>
    <!-- Collision geoms (named *_collision) are reconfigured by mjlab's
         CollisionCfg; the values here are sensible fallbacks. -->
    <default class="collision">
      <geom group="3" contype="1" conaffinity="1" solimp="0.015 1 0.031"
        friction="0.8 0.02 0.01"/>
    </default>
    <joint armature="0.0016" type="hinge" damping="0.01" frictionloss="0.125"
      limited="true"/>
    <default class="so101">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"
        material="so101_print"/>
      <!-- sts3215 class from SO-ARM100 joints_properties.xml. -->
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <default class="so101_servo">
        <geom material="so101_servo"/>
      </default>
    </default>
    <default class="mount">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
    </default>
  </default>

